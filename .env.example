# ---------------------------------------------------------------------------
# Local configuration template.
#
#   1. Copy this file to ".env" in the repo root (".env" is git-ignored, never commit it).
#   2. Fill in the values. Write KEY=value: no quotes, no spaces around "=".
#
# Who reads .env:
#   - Every Spring Boot service (spring.config.import in application.properties), whether
#     you start it from the repo root (IDE) or from its own folder (./mvnw spring-boot:run).
#   - Docker Compose, when run from the repo root.
# A real environment variable with the same name overrides the value in .env.
# ---------------------------------------------------------------------------

# --- REQUIRED: Mailtrap sandbox SMTP (Mailtrap > Email Testing > Inboxes > SMTP Settings) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- OPTIONAL: everything below has a working local default. Uncomment to override. ---

# Notification sender address
#MAIL_FROM=springshop@email.com

# Databases (must match the passwords the containers were first created with)
#ORDER_DB_URL=jdbc:mysql://localhost:3307/order_service
#ORDER_DB_USERNAME=root
#ORDER_DB_PASSWORD=mysql
#INVENTORY_DB_URL=jdbc:mysql://localhost:3308/inventory_service
#INVENTORY_DB_USERNAME=root
#INVENTORY_DB_PASSWORD=mysql
# If you change MONGO_PASSWORD, change it inside MONGODB_URI too
#MONGO_USERNAME=root
#MONGO_PASSWORD=password
#MONGODB_URI=mongodb://root:password@localhost:27017/product-service?authSource=admin

# Kafka
#KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#SCHEMA_REGISTRY_URL=http://localhost:8085

# API gateway
#PRODUCT_SERVICE_URL=http://localhost:8080
#ORDER_SERVICE_URL=http://localhost:8081
#INVENTORY_SERVICE_URL=http://localhost:8082
#CORS_ALLOWED_ORIGINS=http://localhost:4200
#KEYCLOAK_ISSUER_URI=http://localhost:8181/realms/spring-microservices-shoaib
#ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Keycloak containers
#KEYCLOAK_ADMIN=admin
#KEYCLOAK_ADMIN_PASSWORD=admin
#KEYCLOAK_DB_PASSWORD=password
#KEYCLOAK_DB_ROOT_PASSWORD=rootc
